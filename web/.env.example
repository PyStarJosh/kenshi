# Copy to web/.env.local for `vercel dev`, and set the same names in the Vercel project (Settings, Environment Variables).
# Never commit real values; .env.local is ignored by git.

# Google AI Studio key for the Find function (web/api/locate.ts). Required.
GEMINI_API_KEY=

# Optional: the Gemini model to use. Leave empty to use the function's default; set it if Google retires that model.
GEMINI_MODEL=
